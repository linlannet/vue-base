{
  "name": "ll-editor",
  "version": "0.1.0",
  "description": "A plugin-based, business-agnostic code editor with syntax highlight, save/load and pluggable runtime/debugging.",
  "type": "module",
  "main": "./dist/ll-editor.cjs",
  "module": "./dist/ll-editor.js",
  "exports": {
    ".": {
      "import": "./dist/ll-editor.js",
      "require": "./dist/ll-editor.cjs",
      "default": "./dist/ll-editor.js"
    },
    "./style.css": "./dist/ll-editor.css"
  },
  "style": "./dist/ll-editor.css",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -p tsconfig.json --noEmit && vite build",
    "build:lib": "vue-tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit && vue-tsc -p tsconfig.node.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "docs": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "preview": "vite preview --port 3000 --strictPort"
  },
  "dependencies": {
    "monaco-editor": "^0.52.2",
    "typescript": "~5.6.3"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "@vitest/coverage-v8": "^2.1.8",
    "jsdom": "^25.0.1",
    "vite": "^5.4.11",
    "vitepress": "^1.5.0",
    "vitest": "^2.1.8",
    "vue": "^3.5.13",
    "vue-tsc": "^2.1.10"
  }
}
